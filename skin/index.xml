<?xml version="1.0" encoding="utf-8"?>
<skin>
   <information>
      <name>Lucid</name>
      <version>1.0.0</version>
      <description>
         <![CDATA[Liquid Glass 디자인 언어로 만든 티스토리 스킨. 의존성 없는 순수 CSS·JS. ⓒ 2026 jinho7. Based on hELLO by SangWoo Jeong.]]>
      </description>
      <license>
         <![CDATA[MIT]]>
      </license>
   </information>
   <author>
      <name>jinho7</name>
      <homepage>https://github.com/jinho7/lucid-tistory-skin</homepage>
   </author>
   <liststyle>
    <item>
      <value>list</value>
      <label>리스트</label>
    </item>
    <item>
      <value>grid</value>
      <label>그리드</label>
    </item>
    <item>
      <value>zigzag</value>
      <label>지그재그</label>
    </item>
   </liststyle>
   <cover>
    <item>
      <name>list</name>
      <label>리스트</label>
      <description>리스트 형태로 글을 보여줍니다.</description>
    </item>
    <item>
      <name>grid</name>
      <label>그리드</label>
      <description>그리드 형태로 글을 보여줍니다.</description>
    </item>
    <item>
      <name>zigzag</name>
      <label>지그재그</label>
      <description>지그재그 형태로 글을 보여줍니다.</description>
    </item>
    <item>
      <name>slideshow</name>
      <label>슬라이드쇼</label>
      <description>슬라이드쇼 형태로 글을 보여줍니다.</description>
    </item>
   </cover>
   <variables>
     <variablegroup name="사이드바">
       <variable>
         <name>sidebar</name>
         <label>사이드바</label>
         <description><![CDATA[ 사이드바 ]]></description>
         <type>BOOL</type>
         <default>true</default>
       </variable>
       <variable>
         <name>foldable-category</name>
         <label>카테고리 접기/펼치기</label>
         <description><![CDATA[ 카테고리 접기/펼치기 ]]></description>
         <type>BOOL</type>
         <default>true</default>
       </variable>
       <variable>
         <name>subscribers</name>
         <label>구독자 수</label>
         <description><![CDATA[ 사이드바 방문 지표에 표시할 구독자 수. 티스토리가 스킨에 이 값을 주지 않아 직접 적어야 합니다. 비우거나 0 이면 글당 평균 조회수를 보여줍니다. ]]></description>
         <type>STRING</type>
         <default>0</default>
       </variable>
     </variablegroup>
     <variablegroup name="블로그">
       <variable>
         <name>favicon</name>
         <label>파비콘</label>
         <description><![CDATA[ 탭·즐겨찾기 아이콘 이미지 주소. 비우면 관리 → 블로그 에서 올린 파비콘을 씁니다. ]]></description>
         <type>STRING</type>
         <default></default>
       </variable>
       <variable>
         <name>hide-menubar</name>
         <label>관리자 메뉴바 숨기기</label>
         <description><![CDATA[ 로그인한 주인에게 뜨는 티스토리 글쓰기·관리 바를 숨깁니다. 기본은 보입니다. ]]></description>
         <type>BOOL</type>
         <default>false</default>
       </variable>
     </variablegroup>
     <variablegroup name="글">
       <variable>
         <name>width</name>
         <label>너비</label>
         <description><![CDATA[ 너비 ]]></description>
         <type>STRING</type>
         <default>720</default>
       </variable>
       <variable>
         <name>toc</name>
         <label>목차(Table Of Contents)</label>
         <description><![CDATA[ 목차(Table Of Contents) ]]></description>
         <type>BOOL</type>
         <default>true</default>
       </variable>
       <variable>
         <name>scrollspy</name>
         <label>목차(Scrollspy)</label>
         <description><![CDATA[ 목차 (Scrollspy) ]]></description>
         <type>BOOL</type>
         <default>true</default>
       </variable>
       <variable>
         <name>hljs</name>
         <label>코드 하이라이팅(라이트)</label>
         <description><![CDATA[ 코드 하이라이팅(라이트) ]]></description>
         <type>STRING</type>
         <default>xcode</default>
       </variable>
       <variable>
         <name>hljs-dark</name>
         <label>코드 하이라이팅(다크)</label>
         <description><![CDATA[ 코드 하이라이팅(다크) ]]></description>
         <type>STRING</type>
         <default>vs2015</default>
       </variable>
       <variable>
         <name>foldable-reply</name>
         <label>댓글 접기/펼치기</label>
         <description><![CDATA[ 댓글 접기/펼치기 ]]></description>
         <type>BOOL</type>
         <default>true</default>
       </variable>
     </variablegroup>
     <variablegroup name="홈 히어로">
       <variable>
         <name>hero-badge</name>
         <label>말풍선 라벨</label>
         <description><![CDATA[ 첫 화면 맨 위 작은 말풍선. 비우면 숨겨집니다. ]]></description>
         <type>STRING</type>
         <default>I LEARN BY WRITING</default>
       </variable>
       <variable>
         <name>hero-title</name>
         <label>큰 제목</label>
         <description><![CDATA[ 첫 화면의 큰 제목 첫 줄 ]]></description>
         <type>STRING</type>
         <default>Today I Learned</default>
       </variable>
       <variable>
         <name>hero-words</name>
         <label>타이핑 단어</label>
         <description><![CDATA[ 제목 아래에서 순환하는 단어. 쉼표로 구분. 비우면 카테고리 이름을 씁니다. ]]></description>
         <type>STRING</type>
         <default></default>
       </variable>
       <variable>
         <name>hero-sub</name>
         <label>부제</label>
         <description><![CDATA[ 구분선 아래 한 줄 소개. 비우면 숨겨집니다. ]]></description>
         <type>STRING</type>
         <default>배운 걸 잊지 않으려고 적기 시작했습니다.</default>
       </variable>
       <variable>
         <name>home-posts</name>
         <label>홈 최신 글 개수</label>
         <description><![CDATA[ 홈에 보일 최신 글 수. 관리 → 블로그 → 글 목록 개수와 같게 맞추세요. 0 이면 자르지 않습니다. ]]></description>
         <type>STRING</type>
         <default>5</default>
       </variable>
     </variablegroup>
  </variables>
  <default>
    <liststyle>list</liststyle>
    <recentEntries>5</recentEntries>
    <recentComments>5</recentComments>
    <lengthOfRecentNotice>32</lengthOfRecentNotice>
    <lengthOfRecentEntry>32</lengthOfRecentEntry>
    <lengthOfRecentComment>32</lengthOfRecentComment>
  </default>
</skin>
